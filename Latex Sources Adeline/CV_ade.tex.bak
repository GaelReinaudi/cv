\makeatletter
\def\@@rubrichead#1{%
  \@rubricfont%
  \makebox[0pt][l]{\colorbox[gray]{0.7}{\makebox[\linewidth-4\fboxsep]{}}}%
  \makebox[\linewidth-2\fboxsep][c]{#1}}
\def\@@subrubric#1{%
  \rule{0bp}{\@beforespace}
  {\@subrubricfont%
    \makebox[1ex][l]{\colorbox[gray]{0.7}{%
    \phantom M%
    }}#1}%
  \@subrubricmark{#1}}
\makeatother

